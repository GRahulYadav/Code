from queue import PriorityQueue

goal = [[1, 2, 3], [4, 5, 6], [7, 8, 0]]
moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

def manhattan(p):
    return sum(abs(i - (v - 1) // 3) + abs(j - (v - 1) % 3)
               for i in range(3) for j in range(3)
               if (v := p[i][j]) != 0)

def find_zero(p):
    for i in range(3):
        for j in range(3):
            if p[i][j] == 0:
                return i, j

def next_states(p):
    i, j = find_zero(p)
    states = []
    for di, dj in moves:
        ni, nj = i + di, j + dj
        if 0 <= ni < 3 and 0 <= nj < 3:
            new = [row[:] for row in p]
            new[i][j], new[ni][nj] = new[ni][nj], new[i][j]
            states.append(new)
    return states

def solve(start):
    q = PriorityQueue()
    seen = set()
    q.put((manhattan(start), start))
    seen.add(str(start))

    while not q.empty():
        _, cur = q.get()
        for row in cur:
            print(row)
        print()

        if cur == goal:
            print("✅ Solved!")
            return

        for nxt in next_states(cur):
            s = str(nxt)
            if s not in seen:
                seen.add(s)
                q.put((manhattan(nxt), nxt))
    print("❌ No solution")

# Input from user
print("Enter the 3x3 puzzle row by row (use 0 for blank):")
start = [list(map(int, input().split())) for _ in range(3)]
solve(start)
